# ==============================================
# KYLVA AGENCY - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ==============================================

# ==============================================
# GOOGLE ANALYTICS 4
# ==============================================
# Get your Measurement ID from Google Analytics
# Visit: https://analytics.google.com
# Format: G-XXXXXXXXXX
NUXT_PUBLIC_GA_ID=

# ==============================================
# CONTACT DETAILS SHOWN ON THE SITE (hidden while empty)
# ==============================================
# Business email, e.g. hello@kylva.com (never a personal address)
NUXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number with country code, digits only, e.g. 2348012345678
NUXT_PUBLIC_WHATSAPP=

# ==============================================
# CONTACT FORM EMAIL (Resend)
# ==============================================
# RESEND_API_KEY=
# Where new quote requests are sent (private, never shown on the site)
# CONTACT_RECEIVER_EMAIL=
# Sender on a domain verified in Resend, e.g. Kylva <hello@kylva.com>.
# Needed for the automatic "thanks, we got it" reply to the customer.
# FROM_EMAIL=

# ==============================================
# DATABASE (PostgreSQL)
# ==============================================
# When you set up AWS RDS PostgreSQL
# MONGODB_URI=mongodb://username:password@host:port/database

# ==============================================
# JWT AUTHENTICATION (Future)
# ==============================================
# JWT_SECRET=your-super-secret-jwt-key-here
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
# JWT_REFRESH_EXPIRES_IN=30d

# ==============================================
# PAYMENT GATEWAY (Paystack)
# ==============================================
# When you set up payments
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# NUXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# ==============================================
# APP CONFIGURATION
# ==============================================
# NUXT_PUBLIC_APP_NAME=Kylva
# NUXT_PUBLIC_APP_URL=https://kylva.com
# NUXT_PUBLIC_APP_DESCRIPTION=International Web Development Agency

# ==============================================
# NOTES
# ==============================================
# 1. PRIORITY: Add NUXT_PUBLIC_GA_ID first for analytics
# 2. Update social media URLs in nuxt.config.js once created
# 3. Set NUXT_PUBLIC_CONTACT_EMAIL once the business email exists
# 4. Keep this file updated as you add new environment variables